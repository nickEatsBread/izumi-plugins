  "description": "Watch Crunchyroll in izumi: your Crunchyroll account as a source, a Crunchyroll-orange look, the Crunchyroll intro at start-up, and protected playback on Linux and the Steam Deck. Needs a Crunchyroll account. Inspired by Crunchy Deck.",
  "icon": "https://raw.githubusercontent.com/nickEatsBread/crunchydeck-for-izumi/17cd4cbf73c1c4f1497b523561827dd5dcea8d6e/izumi/icon.svg",
  "homepage": "https://github.com/nickEatsBread/crunchydeck-for-izumi",
  "minAppVersion": "0.1.75",
  "stores": [
    {
      "url": "https://raw.githubusercontent.com/nickEatsBread/izumi-plugins/main/store.json"
    }
  ],
  "items": [
    {
      "ref": "source",
      "kind": "source",
      "from": {
        "store": "https://raw.githubusercontent.com/nickEatsBread/izumi-plugins/main/store.json",
        "id": "crunchyroll.izumi"
      },
      "screen": "default"
    },
    {
      "ref": "look",
      "kind": "theme",
      "from": {
        "store": "https://raw.githubusercontent.com/nickEatsBread/izumi-plugins/main/store.json",
        "id": "crunchy-deck"
      },
      "apply": true
    }
  ],
  "modules": [
    {
      "id": "widevine"
    }
  ],
  "startup": {
    "video": {
